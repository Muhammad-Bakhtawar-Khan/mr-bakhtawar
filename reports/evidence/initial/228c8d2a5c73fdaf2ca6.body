<script>
(function(){
 const search=document.getElementById('faqSearch'), filters=[...document.querySelectorAll('.faq-filter')], items=[...document.querySelectorAll('.faq-item')], results=document.getElementById('faqResults'), empty=document.getElementById('faqEmpty'), reset=document.getElementById('faqReset');
 let category='all';
 function update(){const q=(search.value||'').trim().toLowerCase();let count=0;items.forEach(item=>{const matchesCategory=category==='all'||item.dataset.category===category;const matchesText=!q||item.textContent.toLowerCase().includes(q);const show=matchesCategory&&matchesText;item.hidden=!show;if(show)count++;});results.textContent='Showing '+count+' '+(count===1?'answer':'answers')+(category==='all'?' across all topics':' in '+category);empty.hidden=count!==0;}
 filters.forEach(btn=>btn.addEventListener('click',()=>{category=btn.dataset.filter;filters.forEach(b=>{const active=b===btn;b.classList.toggle('is-active',active);b.setAttribute('aria-pressed',String(active));});update();}));
 search.addEventListener('input',update);reset.addEventListener('click',()=>{search.value='';category='all';filters.forEach(b=>{const active=b.dataset.filter==='all';b.classList.toggle('is-active',active);b.setAttribute('aria-pressed',String(active));});update();search.focus();});
})();
</script><script src="assets/js/script.js"></script><footer class="academy-footer"><div><a class="academy-brand personal-brand" href="/"><span>Bakhtawar Khan<small>Personal Digital Portfolio · MBK Global</small></span></a><p>Thoughtful technology. Useful knowledge. Work in progress.</p></div><nav aria-label="Footer"><a href='/resources'>Resources</a><a href='/official-links'>Official links</a><a href='/gallery'>Gallery</a><a href='/resume'>Resume</a><a href='/faq'>FAQ</a><a href='/privacy-policy'>Privacy</a></nav><div class="academy-colophon"><span>© 2026 Bakhtawar Khan · MBK Global</span><a href="#top">Back to top ↑</a></div></footer><script defer src="/assets/js/portfolio.js"></script></body></html>