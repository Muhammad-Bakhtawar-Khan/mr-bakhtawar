<script src="assets/js/script.js"></script><script>
(function(){
  const reduceMotion=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  function setupCarousel(section, selector, label, interval){
    if(!section || section.dataset.mbkCarouselReady==='1') return;
    const track=section.querySelector(selector); if(!track) return;
    const slides=Array.from(track.children).filter(el=>el.matches('figure, a, .home-gallery-card, .photo-item, .home-gallery-item'));
    if(slides.length<2) return;
    section.dataset.mbkCarouselReady='1'; section.classList.add('mbk-auto-gallery');
    track.classList.add('mbk-carousel-track');
    const viewport=document.createElement('div'); viewport.className='mbk-carousel-viewport';
    track.parentNode.insertBefore(viewport,track); viewport.appendChild(track);
    const controls=document.createElement('div'); controls.className='mbk-carousel-controls';
    controls.innerHTML='<div class="mbk-carousel-status"><span class="mbk-carousel-count" aria-live="polite">01 / '+String(slides.length).padStart(2,'0')+'</span><span class="mbk-carousel-progress" aria-hidden="true"><span></span></span><span class="mbk-carousel-label">'+label+'</span></div><div class="mbk-carousel-actions"><button type="button" class="mbk-prev" aria-label="Previous photo">←</button><button type="button" class="mbk-play" aria-label="Pause automatic slideshow" aria-pressed="false">Ⅱ</button><button type="button" class="mbk-next" aria-label="Next photo">→</button></div>';
    viewport.after(controls);
    const count=controls.querySelector('.mbk-carousel-count'), progress=controls.querySelector('.mbk-carousel-progress span'), play=controls.querySelector('.mbk-play');
    let current=0, timer=null, paused=reduceMotion, inView=true, userInteracting=false;
    function index(){let best=0, distance=Infinity; const left=track.getBoundingClientRect().left; slides.forEach((s,i)=>{const d=Math.abs(s.getBoundingClientRect().left-left);if(d<distance){distance=d;best=i}});return best;}
    function update(){current=index();count.textContent=String(current+1).padStart(2,'0')+' / '+String(slides.length).padStart(2,'0');progress.style.width=((current+1)/slides.length*100)+'%';}
    function go(i){current=(i+slides.length)%slides.length;slides[current].scrollIntoView({behavior:reduceMotion?'auto':'smooth',block:'nearest',inline:'start'});update();}
    function stop(){if(timer){clearInterval(timer);timer=null;}}
    function start(){stop();if(!paused&&inView&&!userInteracting)timer=setInterval(()=>go(index()+1),interval);}
    function setPaused(v){paused=v;play.setAttribute('aria-pressed',String(paused));play.setAttribute('aria-label',paused?'Play automatic slideshow':'Pause automatic slideshow');play.textContent=paused?'▶':'Ⅱ';start();}
    controls.querySelector('.mbk-prev').addEventListener('click',()=>{go(index()-1);start()});
    controls.querySelector('.mbk-next').addEventListener('click',()=>{go(index()+1);start()});
    play.addEventListener('click',()=>setPaused(!paused));
    track.addEventListener('scroll',()=>{if(!userInteracting)update()},{passive:true});
    viewport.addEventListener('mouseenter',()=>{userInteracting=true;stop()});
    viewport.addEventListener('mouseleave',()=>{userInteracting=false;start()});
    viewport.addEventListener('focusin',()=>{userInteracting=true;stop()});
    viewport.addEventListener('focusout',e=>{if(!viewport.contains(e.relatedTarget)){userInteracting=false;start()}});
    let touchStart=0; viewport.addEventListener('touchstart',e=>{touchStart=e.touches[0].clientX;stop()},{passive:true});
    viewport.addEventListener('touchend',e=>{const delta=e.changedTouches[0].clientX-touchStart;if(Math.abs(delta)>45)go(index()+(delta<0?1:-1));start()},{passive:true});
    if('IntersectionObserver' in window){const observer=new IntersectionObserver(entries=>{inView=entries[0].isIntersecting;start()},{threshold:.12});observer.observe(section)}
    if(reduceMotion) setPaused(true); else start(); update();
  }
  document.addEventListener('DOMContentLoaded',function(){
    setupCarousel(document.querySelector('#bakhtawar-photo-gallery'),' .home-gallery-grid','PERSONAL ARCHIVE',5200);
    setupCarousel(document.querySelector('#home-photo-gallery'),' .home-gallery-grid','VISUAL PROFILE',4200);
    setupCarousel(document.querySelector('.mbk-portrait-gallery'),' .mbk-photo-grid','THE PERSON BEHIND THE BUILDS',5000);
    setupCarousel(document.querySelector('main.inner-page'),' .photo-gallery','MR. BAKHTAWAR GALLERY',4200);
  });
})();
</script>
